super + shift + e
    bspc quit 0

super + {_,shift +} {h,j,k,l}
    bspc node -{f,s} {west,south,north,east}

super + {n,p}
    bspc desktop -f {prev,next}.local.occupied

super + f
    bspc desktop -l next

super + shift + f
    bspc node -t \~fullscreen

super + shift + q
    bspc node --close

super + q
    qutebrowser

super + a; {f,g,d,s,a,r,t,e,w,q,v,b,c,x,z,j,h,k,l,semicolon,u,y,i,o,p,m,n,comma,period,slash}
    bspc desktop -f {f,g,d,s,a,r,t,e,w,q,v,b,c,x,z,j,h,k,l,";",u,y,i,o,p,m,n,",",".","/"}

super + a; shift + {f,g,d,s,a,r,t,e,w,q,v,b,c,x,z,j,h,k,l,semicolon,u,y,i,o,p,m,n,comma,period,slash}
    bspc node -d {f,g,d,s,a,r,t,e,w,q,v,b,c,x,z,j,h,k,l,";",u,y,i,o,p,m,n,",",".","/"} --follow

super + v; {h,j,k,l}
    bspc node -f @{west,south,north,east}

super + {_,shift +} r
    bspc node -R {90,270}

XF86AudioPlay
    playerctl -p spotify play-pause

XF86AudioNext
    playerctl -p spotify next

XF86AudioPrev
    playerctl -p spotify previous

super + s
    escrotum --select --clipboard

super + shift + s
    escrotum '~/media/img/screenshots/%b-%-d-%Y-%-H:%-M:%-S.png'
