{% macro clamp(v, lo, hi) -%}
  {{ [lo, [v, hi] | min] | max }}
{%- endmacro %}

{% macro map_range(v, in_min, in_max, out_min, out_max) -%}
  {{ (v - in_min) * (out_max - out_min) / (in_max - in_min) + out_min }}
{%- endmacro %}

{% macro to_rad(deg) -%}
    {{ deg * pi / 180 }}
{%- endmacro %}

{% macro from_rad(rad) -%}
    {{ rad * 180 / pi }}
{%- endmacro %}

{# Signed horizontal offset from window normal in [-180, 180] #}
{% macro relative_sun_offset(sun_az, win_az) -%}
    {{ ((sun_az - win_az + 540) % 360) - 180 }}
{%- endmacro %}

{# Window-relative vertical angle (fully defined; no guards/policy) #}
{% macro relative_sun_elevation(sun_el, win_off) -%}
  {%- set rad_el = to_rad(sun_el) -%}
  {%- set rad_off = to_rad(win_off) -%}
  {%- set calc = atan2(sin(rad_el), cos(rad_el) * cos(rad_off)) -%}
  {{ from_rad(calc) }}
{%- endmacro %}

{# Window-relative elevation to cover percent #}
{% macro elevation_to_tilt(win_el) -%}
  {%- set MAX_TILT = 81 -%}
  {%- set SUNRISE_ANGLE = 9.0 -%}
  {%- set SUNSET_ANGLE = 2.5 -%}

  {%- set sun_el = state_attr("sun.sun", "elevation") | float(-90) -%}
  {%- set rising = state_attr("sun.sun", "rising") -%}
  {%- set min_sun_el = SUNRISE_ANGLE if rising else SUNSET_ANGLE -%}

  {%- if sun_el < min_sun_el -%}
    0
  {%- elif win_el > MAX_TILT - 10 -%}
    50
  {%- else -%}
    {{ (MAX_TILT - win_el) * 100 / (MAX_TILT * 2) }}
  {%- endif -%}
{%- endmacro %}

{#
  Given a list of entity_ids, a target value, and a threshold,
  return a list of entity_ids whose current_tilt_position differs
  significantly from the target.
#}
{% macro entities_tilt_delta(entities, target, threshold) -%}
  {% set ns = namespace(out=[]) %}

  {% for e in entities %}
    {% set curr = state_attr(e, 'current_tilt_position') | float(none) %}
    {% if target is not none and curr is not none and (target - curr) | abs > threshold %}
      {% set ns.out = ns.out + [e] %}
    {% endif %}
  {% endfor %}

  {{ ns.out }}
{%- endmacro %}
