{% macro clamp(v, lo, hi) -%}
  {{ [lo, [v, hi] | min] | max }}
{%- endmacro %}

{% macro map_range(v, in_min, in_max, out_min, out_max) -%}
  {{ (v - in_min) * (out_max - out_min) / (in_max - in_min) + out_min }}
{%- endmacro %}

{% macro to_rad(deg) -%}
    {{ deg * pi / 180 }}
{%- endmacro %}

{% macro from_rad(rad) -%}
    {{ rad * 180 / pi }}
{%- endmacro %}

{# Signed horizontal offset from window normal in [-180, 180] #}
{% macro relative_sun_offset(sun_az, win_az) -%}
    {{ ((sun_az - win_az + 540) % 360) - 180 }}
{%- endmacro %}

{# Window-relative vertical angle (fully defined; no guards/policy) #}
{% macro relative_sun_elevation(sun_el, win_off) -%}
  {%- set rad_el = to_rad(sun_el) -%}
  {%- set rad_off = to_rad(win_off) -%}
  {%- set calc = atan2(sin(rad_el), cos(rad_el) * cos(rad_off)) -%}
  {{ from_rad(calc) }}
{%- endmacro %}

{# Window-relative elevation to cover percent #}
{% macro elevation_to_tilt(sun_el) -%}
  {%- set MAX_TILT = 81 -%}
  {%- if sun_el < 0 -%}
    0
  {%- elif sun_el > 90 -%}
    50
  {%- else -%}
    {{ (MAX_TILT - sun_el) * 100 / (MAX_TILT * 2) }}
  {%- endif -%}
{%- endmacro %}

{# True if the sun is high enough to track blinds.
  Uses different thresholds for morning vs evening.
#}
{% macro sun_active_band(sunrise_min=12, sunset_min=6) -%}
  {%- set sun_el = state_attr("sun.sun", "elevation") | float(-90) -%}
  {%- set rising = state_attr("sun.sun", "rising") -%}
  {%- set min_el = sunrise_min if rising else sunset_min -%}
  {{ sun_el > min_el }}
{%- endmacro %}

{# True if the difference between target and current exceeds the given threshold. #}
{% macro significant_delta(target, current, threshold=5) -%}
  {{ target is not none and current is not none and (target - current) | abs > threshold }}
{%- endmacro %}

{#
  Given a list of entity_ids, a target value, and a threshold,
  return a list of entity_ids whose current_tilt_position differs
  significantly from the target.
#}
{% macro entities_tilt_delta(entities, target, threshold=5) -%}
  {% set ns = namespace(out=[]) %}

  {% for e in entities %}
    {% set cur = state_attr(e, 'current_tilt_position') | float(none) %}
    {% if significant_delta(target, cur, threshold) %}
      {% set ns.out = ns.out + [e] %}
    {% endif %}
  {% endfor %}

  {{ ns.out }}
{%- endmacro %}
