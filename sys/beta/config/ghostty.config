##############################################
# Terminal Behavior
##############################################

# Disable accidental close warnings
confirm-close-surface = false

# Window behavior
window-padding-x = 5
window-padding-y = 5
window-inherit-working-directory = true
# window-colorspace = display-p3

# Bell behavior
bell-features = no-title


##############################################
# Font
##############################################
font-family = "Fira Code"
font-size = 14
font-variation = wght=500

# Tweaks for cell/cursor appearance
adjust-cell-width = -2
adjust-cell-height = -2
adjust-cursor-thickness = 2
adjust-underline-thickness = 2


##############################################
# Shell
##############################################
command = /etc/profiles/per-user/mmazzanti/bin/zsh
shell-integration = zsh


##############################################
# Colors — Gruvbox Dark Palette
##############################################

# Base
palette = 0=#282828
palette = 8=#928374

# Red
palette = 1=#cc241d
palette = 9=#fb4934

# Green
palette = 2=#98971a
palette = 10=#b8bb26

# Yellow
palette = 3=#d79921
palette = 11=#fabd2f

# Blue
palette = 4=#458588
palette = 12=#83a598

# Magenta
palette = 5=#b16286
palette = 13=#d3869b

# Cyan
palette = 6=#689d6a
palette = 14=#8ec07c

# White
palette = 7=#a89984
palette = 15=#ebdbb2

# Background / Foreground / Cursor / Selection
background           = #282828
foreground           = #ebdbb2
cursor-color         = #ebdbb2
cursor-text          = #282828
selection-background = #504945
selection-foreground = #ebdbb2

# Split decorations
split-divider-color     = #504945
unfocused-split-fill    = #444444
unfocused-split-opacity = .8


##############################################
# Keybindings
##############################################

# Disable built-in behaviors
keybind = cmd+h=ignore
keybind = shift+enter=ignore

# Splits
keybind = cmd+enter=new_split:right
keybind = cmd+shift+enter=new_split:down

# Move focus (vim-style)
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right

# Resizing
keybind = cmd+shift+h=resize_split:left,10
keybind = cmd+shift+j=resize_split:down,10
keybind = cmd+shift+k=resize_split:up,10
keybind = cmd+shift+l=resize_split:right,10
