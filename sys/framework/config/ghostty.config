# Disable close warnings
confirm-close-surface = false

macos-titlebar-style = tabs

window-padding-x = 5
window-padding-y = 5

title = " "
window-inherit-working-directory = true

# ================================
# Font
# ================================
font-family = "Fira Code"
font-size   = 11
font-variation = wght=400
font-variation-bold = wght=600
adjust-cell-width = -1
adjust-cell-height = -2
adjust-cursor-thickness = 2

# ================================
# Shell
# ================================
# command = /etc/profiles/per-user/mmazzanti/bin/zsh
# shell-integration = zsh

# ================================
# Gruvbox Dark Palette
# ================================
# base
palette = 0=#282828
palette = 8=#928374

# red
palette = 1=#cc241d
palette = 9=#fb4934

# green
palette = 2=#98971a
palette = 10=#b8bb26

# yellow
palette = 3=#d79921
palette = 11=#fabd2f

# blue
palette = 4=#458588
palette = 12=#83a598

# magenta
palette = 5=#b16286
palette = 13=#d3869b

# cyan
palette = 6=#689d6a
palette = 14=#8ec07c

# white
palette = 7=#a89984
palette = 15=#ebdbb2

# background/foreground/cursor
background           = #282828
foreground           = #ebdbb2
cursor-color         = #ebdbb2
cursor-text          = #282828
selection-background = #504945
selection-foreground = #ebdbb2
split-divider-color  = #504945
unfocused-split-fill = #444444

# ================================
# Splits and Keybindings
# ================================
keybind = cmd+h=ignore
keybind = shift+enter=ignore

# Create new splits
# Shift+Enter → vertical (new pane on the right)
keybind = cmd+enter=new_split:right
# Cmd+Shift+Enter → horizontal (new pane below)
keybind = cmd+shift+enter=new_split:down

# Move focus between splits (vim-style)
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right

app-notifications = no-clipboard-copy
