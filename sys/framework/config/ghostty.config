# Disable close warnings
confirm-close-surface = false

macos-titlebar-style = tabs

window-padding-x = 5
window-padding-y = 5

title = " "
window-inherit-working-directory = true
# Bell behavior
bell-features = no-title

# ================================
# Font
# ================================
font-family = "Fira Code"
font-size   = 11
font-variation = wght=400
font-variation-bold = wght=600
adjust-cell-width = -1
adjust-cell-height = -2
adjust-cursor-thickness = 2

# ================================
# Shell
# ================================
shell-integration = zsh
shell-integration-features = no-cursor

# ================================
# Gruvbox Dark Palette
# ================================
# base
palette = 0=#282828
palette = 8=#928374

# red
palette = 1=#cc241d
palette = 9=#fb4934

# green
palette = 2=#98971a
palette = 10=#b8bb26

# yellow
palette = 3=#d79921
palette = 11=#fabd2f

# blue
palette = 4=#458588
palette = 12=#83a598

# magenta
palette = 5=#b16286
palette = 13=#d3869b

# cyan
palette = 6=#689d6a
palette = 14=#8ec07c

# white
palette = 7=#a89984
palette = 15=#ebdbb2

# background/foreground/cursor
background           = #282828
foreground           = #ebdbb2
cursor-color         = #ebdbb2
cursor-text          = #282828
selection-background = #504945
selection-foreground = #ebdbb2
split-divider-color  = #a89984
unfocused-split-fill = #504945
unfocused-split-opacity = .8

##############################################
# Keybindings
##############################################

# Disable built-in behaviors
keybind = cmd+h=ignore
# keybind = shift+enter=ignore

# Splits
keybind = cmd+enter=new_split:right
keybind = cmd+shift+enter=new_split:down

# Move focus (vim-style)
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right

# Resizing
keybind = cmd+shift+h=resize_split:left,20
keybind = cmd+shift+j=resize_split:down,20
keybind = cmd+shift+k=resize_split:up,20
keybind = cmd+shift+l=resize_split:right,20
