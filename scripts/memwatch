#!/usr/bin/env python3
"""Memory + thermal + per-process monitor for game-stutter diagnosis.

Stdlib only. Every probe is independently fault-tolerant: anything that
can't be read (no game running, process exited mid-sample, missing sysfs
node) prints '-' for that column and sampling continues.

On the desktop:  memwatch [interval-seconds]
From elsewhere:  ssh desktop.lan 'python3 -' < scripts/memwatch | tee memlog.txt

Marking events: `echo "stutter start" > /tmp/memwatch.mark` from any
terminal drops a MARK row into the log at that timestamp.

GAME_FPS comes from MangoHud headless logging (newest CSV under
/tmp/mangohud); see docs/cs2-session-runbook.txt for the launch-line
env vars that enable it.

Column legend and interpretation: docs/cs2-stutter-investigation.md
"""

import glob
import os
import sys
import time

INTERVAL = float(sys.argv[1]) if len(sys.argv) > 1 else 5.0
MARK_FILE = "/tmp/memwatch.mark"
FPS_DIR = "/tmp/mangohud"
GAME_NAMES = ("cs2", "dota2", "hl2_linux")

COLS = [
    # (header, width)
    ("TIME", 8), ("AVAIL_MB", 9), ("ARC_MB", 8), ("PSI", 6),
    ("CPU_C", 6), ("GPU_J", 6), ("GPU_MEM", 8), ("SCLK_MHZ", 9),
    ("FAN", 6), ("BUSY", 6), ("VRAM_MB", 8), ("GTT_MB", 7),
    ("GAME_RSS", 9), ("GAME_VRAM", 10), ("GAME_FD", 8), ("GAME_THR", 8),
    ("WEBHLP_RSS", 11), ("DIRTY_MB", 8), ("SLAB_MB", 8), ("CTXT_K", 7),
    ("GAME_MAJF", 9), ("GAME_WAIT", 9), ("GAME_FPS", 8),
]


def read(path):
    with open(path) as f:
        return f.read()


def probe(fn, *args):
    """Run a probe, returning None (rendered as '-') on any failure."""
    try:
        return fn(*args)
    except Exception:
        return None


def meminfo_mb(field):
    for line in read("/proc/meminfo").splitlines():
        if line.startswith(field + ":"):
            return int(line.split()[1]) // 1024
    raise KeyError(field)


def arc_mb():
    for line in read("/proc/spl/kstat/zfs/arcstats").splitlines():
        parts = line.split()
        if parts and parts[0] == "size":
            return int(parts[2]) // (1024 * 1024)
    raise KeyError("size")


def psi_mem():
    return read("/proc/pressure/memory").splitlines()[0].split()[1].split("=")[1]


def find_cpu_temp():
    for h in glob.glob("/sys/class/hwmon/hwmon*"):
        if probe(read, h + "/name") == "k10temp\n":
            return h + "/temp1_input"
    return None


def find_gpu():
    for c in glob.glob("/sys/class/drm/card*/device"):
        if os.path.exists(c + "/gpu_busy_percent"):
            return c
    return None


def find_gpu_temps(gpu):
    junction = mem = fan = None
    for t in glob.glob(gpu + "/hwmon/hwmon*/temp*_input"):
        label = probe(read, t[: -len("_input")] + "_label") or ""
        if label.strip() == "junction":
            junction = t
        elif label.strip() == "mem":
            mem = t
    for f in glob.glob(gpu + "/hwmon/hwmon*/fan1_input"):
        fan = f
    return junction, mem, fan


def temp_c(path):
    return int(read(path)) // 1000


def sclk_mhz(gpu):
    for line in read(gpu + "/pp_dpm_sclk").splitlines():
        if "*" in line:
            return int(line.split(":")[1].strip().rstrip("* ").rstrip("Mhz"))
    raise ValueError("no active sclk state")


def game_pid():
    for pid in sorted(int(p) for p in os.listdir("/proc") if p.isdigit()):
        if probe(read, f"/proc/{pid}/comm") in (n + "\n" for n in GAME_NAMES):
            return pid
    return None


def proc_status_kb(pid, field):
    for line in read(f"/proc/{pid}/status").splitlines():
        if line.startswith(field + ":"):
            return int(line.split()[1])
    raise KeyError(field)


def game_vram_mb(pid):
    total_kb = 0
    for fdinfo in glob.glob(f"/proc/{pid}/fdinfo/*"):
        content = probe(read, fdinfo)
        if not content:
            continue
        for line in content.splitlines():
            if line.startswith("drm-memory-vram:"):
                total_kb += int(line.split()[1])
    return total_kb // 1024


def webhelper_rss_mb():
    total_kb = 0
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        cmdline = probe(read, f"/proc/{pid}/cmdline") or ""
        if "steamwebhelper" in cmdline:
            total_kb += probe(proc_status_kb, int(pid), "VmRSS") or 0
    return total_kb // 1024


def ctxt():
    for line in read("/proc/stat").splitlines():
        if line.startswith("ctxt"):
            return int(line.split()[1])
    raise KeyError("ctxt")


def game_fps():
    """Last FPS sample from the newest fresh MangoHud CSV (first column)."""
    newest = max(glob.glob(FPS_DIR + "/*.csv"), key=os.path.getmtime)
    if time.time() - os.stat(newest).st_mtime > INTERVAL * 3:
        return None
    with open(newest, "rb") as f:
        f.seek(0, os.SEEK_END)
        f.seek(max(0, f.tell() - 4096))
        lines = f.read().decode(errors="replace").splitlines()
    for last in reversed(lines[1:] if len(lines) > 1 else lines):
        tok = last.split(",")[0]
        try:
            v = float(tok)
        except ValueError:
            continue
        if v > 0:
            return int(v)
    return None


def fmt(row):
    return " ".join(
        f"{('-' if v is None else v)!s:>{w}}" if h != "TIME" else f"{v!s:<8}"
        for (h, w), v in zip(COLS, row)
    )


def main():
    cpu_temp = find_cpu_temp()
    gpu = find_gpu()
    gpu_junction, gpu_mem, gpu_fan = find_gpu_temps(gpu) if gpu else (None,) * 3

    print(fmt([h for h, _ in COLS]), flush=True)

    prev_pid = prev_majf = prev_wait = None
    prev_ctxt = probe(ctxt)

    while True:
        if os.path.exists(MARK_FILE):
            note = (probe(read, MARK_FILE) or "").strip()
            print(f"{time.strftime('%H:%M:%S')} ==== MARK {note} ====", flush=True)
            probe(os.remove, MARK_FILE)

        pid = probe(game_pid)

        cur_ctxt = probe(ctxt)
        ctxt_k = None
        if cur_ctxt is not None and prev_ctxt is not None:
            ctxt_k = int((cur_ctxt - prev_ctxt) / INTERVAL / 1000)
        prev_ctxt = cur_ctxt

        majf = wait_ns = None
        if pid:
            majf = probe(lambda: int(read(f"/proc/{pid}/stat").rsplit(")", 1)[1].split()[9]))
            wait_ns = probe(lambda: int(read(f"/proc/{pid}/schedstat").split()[1]))
        game_majf = game_wait = None
        if pid and pid == prev_pid:
            if majf is not None and prev_majf is not None:
                game_majf = majf - prev_majf
            if wait_ns is not None and prev_wait is not None:
                game_wait = (wait_ns - prev_wait) // 1_000_000
        prev_pid, prev_majf, prev_wait = pid, majf, wait_ns

        row = [
            time.strftime("%H:%M:%S"),
            probe(meminfo_mb, "MemAvailable"),
            probe(arc_mb),
            probe(psi_mem),
            probe(temp_c, cpu_temp) if cpu_temp else None,
            probe(temp_c, gpu_junction) if gpu_junction else None,
            probe(temp_c, gpu_mem) if gpu_mem else None,
            probe(sclk_mhz, gpu) if gpu else None,
            probe(lambda: int(read(gpu_fan))) if gpu_fan else None,
            probe(lambda: int(read(gpu + "/gpu_busy_percent"))) if gpu else None,
            probe(lambda: int(read(gpu + "/mem_info_vram_used")) // 1048576) if gpu else None,
            probe(lambda: int(read(gpu + "/mem_info_gtt_used")) // 1048576) if gpu else None,
            probe(lambda: proc_status_kb(pid, "VmRSS") // 1024) if pid else None,
            probe(game_vram_mb, pid) if pid else None,
            probe(lambda: len(os.listdir(f"/proc/{pid}/fd"))) if pid else None,
            probe(proc_status_kb, pid, "Threads") if pid else None,
            probe(webhelper_rss_mb),
            probe(meminfo_mb, "Dirty"),
            probe(meminfo_mb, "SUnreclaim"),
            ctxt_k,
            game_majf,
            game_wait,
            probe(game_fps),
        ]
        print(fmt(row), flush=True)
        time.sleep(INTERVAL)


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        # ^C or downstream pipe (head/tee) closing — normal exits
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
