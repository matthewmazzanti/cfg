#!/usr/bin/env bash
# Memory + thermal monitor for game-stutter diagnosis.
# Prints available RAM, ZFS ARC size, PSI memory pressure, CPU/GPU temps,
# GPU core clock, fan speed, and GPU utilization.
#
# On the desktop:  memwatch [interval-seconds]
# From elsewhere:  ssh desktop.lan 'bash -s' < scripts/memwatch | tee memlog.txt
#
# Reading it: stutter + AVAIL_MB cratering + PSI climbing over ~1.0 means
# memory pressure. GPU_MEM approaching ~95C or SCLK_MHZ sagging while
# BUSY stays high means thermal throttling (VRAM tjmax first suspect).
# VRAM_MB near the card's total with GTT_MB climbing means VRAM
# oversubscription: amdgpu is migrating buffers over PCIe every frame,
# which stutters indefinitely until VRAM consumers exit.
# Per-process columns (- when no game running): monotonic growth in
# GAME_RSS / GAME_VRAM / GAME_FD across a session is a game-side leak
# (see csgo-osx-linux #3808/#3925); WEBHLP_RSS growth that survives game
# restarts implicates the Steam overlay / steamwebhelper.

set -euo pipefail

interval="${1:-5}"

# Locate hwmon/drm paths once
cpu_temp=""
for h in /sys/class/hwmon/hwmon*; do
    [[ "$(cat "$h/name" 2>/dev/null)" == k10temp ]] && cpu_temp="$h/temp1_input"
done

gpu=""
for c in /sys/class/drm/card*/device; do
    [[ -r "$c/gpu_busy_percent" ]] && gpu="$c"
done
gpu_junction="" gpu_mem="" gpu_fan=""
if [[ -n "$gpu" ]]; then
    for t in "$gpu"/hwmon/hwmon*/temp*_input; do
        case "$(cat "${t%_input}_label" 2>/dev/null)" in
            junction) gpu_junction="$t" ;;
            mem)      gpu_mem="$t" ;;
        esac
    done
    for f in "$gpu"/hwmon/hwmon*/fan1_input; do
        [[ -r "$f" ]] && gpu_fan="$f"
    done
fi

temp_c() { [[ -n "$1" && -r "$1" ]] && echo $(( $(cat "$1") / 1000 )) || echo -; }

# Known Source/Source2 game binaries to track; first match wins
game_pid() { pgrep -x cs2 || pgrep -x dota2 || pgrep -x hl2_linux || true; }

printf '%-8s %9s %8s %6s %6s %6s %8s %9s %6s %6s %8s %7s %9s %10s %8s %8s %11s\n' \
    TIME AVAIL_MB ARC_MB PSI CPU_C GPU_J GPU_MEM SCLK_MHZ FAN BUSY VRAM_MB GTT_MB \
    GAME_RSS GAME_VRAM GAME_FD GAME_THR WEBHLP_RSS

while true; do
    avail=$(( $(awk '/^MemAvailable:/ {print $2}' /proc/meminfo) / 1024 ))

    arc=-
    if [[ -r /proc/spl/kstat/zfs/arcstats ]]; then
        arc=$(( $(awk '$1 == "size" {print $3}' /proc/spl/kstat/zfs/arcstats) / 1024 / 1024 ))
    fi

    psi=$(awk 'NR == 1 { sub("avg10=", "", $2); print $2 }' /proc/pressure/memory)

    sclk=- fan=- busy=- vram=- gtt=-
    if [[ -n "$gpu" ]]; then
        sclk=$(grep '\*' "$gpu/pp_dpm_sclk" | grep -o '[0-9]*Mhz' | tr -d Mhz || echo -)
        busy=$(cat "$gpu/gpu_busy_percent")
        [[ -n "$gpu_fan" ]] && fan=$(cat "$gpu_fan")
        vram=$(( $(cat "$gpu/mem_info_vram_used") / 1048576 ))
        gtt=$(( $(cat "$gpu/mem_info_gtt_used") / 1048576 ))
    fi

    game_rss=- game_vram=- game_fd=- game_thr=-
    pid=$(game_pid | head -1)
    if [[ -n "$pid" && -d /proc/$pid ]]; then
        game_rss=$(( $(awk '/^VmRSS:/ {print $2}' /proc/$pid/status) / 1024 ))
        game_thr=$(awk '/^Threads:/ {print $2}' /proc/$pid/status)
        game_fd=$(ls /proc/$pid/fd 2>/dev/null | wc -l)
        # Sum VRAM across the process's DRM clients (KiB in fdinfo)
        game_vram=$(awk '/^drm-memory-vram:/ {s += $2} END {print int(s / 1024)}' \
            /proc/$pid/fdinfo/* 2>/dev/null)
    fi

    webhlp_rss=-
    wh_pids=$(pgrep -f steamwebhelper || true)
    if [[ -n "$wh_pids" ]]; then
        webhlp_rss=$(echo "$wh_pids" | xargs -I{} awk '/^VmRSS:/ {print $2}' /proc/{}/status 2>/dev/null \
            | awk '{s += $1} END {print int(s / 1024)}')
    fi

    printf '%-8s %9s %8s %6s %6s %6s %8s %9s %6s %6s %8s %7s %9s %10s %8s %8s %11s\n' \
        "$(date +%T)" "$avail" "$arc" "$psi" \
        "$(temp_c "$cpu_temp")" "$(temp_c "$gpu_junction")" "$(temp_c "$gpu_mem")" \
        "$sclk" "$fan" "$busy" "$vram" "$gtt" \
        "$game_rss" "$game_vram" "$game_fd" "$game_thr" "$webhlp_rss"
    sleep "$interval"
done
