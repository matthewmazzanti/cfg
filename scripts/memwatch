#!/usr/bin/env bash
# Memory pressure monitor for game-stutter diagnosis.
# Prints available RAM, ZFS ARC size, swap usage, and PSI memory pressure.
#
# On the desktop:  memwatch [interval-seconds]
# From elsewhere:  ssh desktop.lan 'bash -s' < scripts/memwatch | tee memlog.txt
#
# Reading it: stutter + AVAIL_MB cratering + PSI_SOME climbing over ~1.0
# means memory pressure is real. If ARC_MB is pinned at its cap and PSI
# stays near zero during stutter, memory is exonerated.

set -euo pipefail

interval="${1:-5}"

printf '%-8s %9s %9s %9s %9s %9s\n' TIME AVAIL_MB ARC_MB SWAP_MB PSI_SOME PSI_FULL

while true; do
    avail=$(( $(awk '/^MemAvailable:/ {print $2}' /proc/meminfo) / 1024 ))

    arc=-
    if [[ -r /proc/spl/kstat/zfs/arcstats ]]; then
        arc=$(( $(awk '$1 == "size" {print $3}' /proc/spl/kstat/zfs/arcstats) / 1024 / 1024 ))
    fi

    swap_total=$(awk '/^SwapTotal:/ {print $2}' /proc/meminfo)
    swap_free=$(awk '/^SwapFree:/ {print $2}' /proc/meminfo)
    swap=$(( (swap_total - swap_free) / 1024 ))

    some=$(awk 'NR == 1 { sub("avg10=", "", $2); print $2 }' /proc/pressure/memory)
    full=$(awk 'NR == 2 { sub("avg10=", "", $2); print $2 }' /proc/pressure/memory)

    printf '%-8s %9s %9s %9s %9s %9s\n' "$(date +%T)" "$avail" "$arc" "$swap" "$some" "$full"
    sleep "$interval"
done
