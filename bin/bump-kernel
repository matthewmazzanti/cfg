#!/usr/bin/env python3
"""Advance the kernel + zfs pins in lib/pins.json to the newest ZFS-compatible
pair, FORWARD-ONLY (never a downgrade).

Run as part of `just update` (after `nix flake update`), so the bump moves in
lock-step with the flake.lock nixpkgs bump and lands as a reviewable git diff.
base.nix reads the pins via `flake.lib.pins`, mirroring the lib/images.json +
lock-images pattern.

lib/zfs-kernel-matrix.nix is a pure projection: the zfs x linux pairs whose
module isn't broken, with versions. All the policy -- the forward-only floor and
picking the newest pair -- lives here in Python. Stdlib only.
"""

import json
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PINS = ROOT / "lib" / "pins.json"

Version = tuple[int, int, int]


def version(s: str) -> Version:
    """Parse a version to a (major, minor, patch) tuple, zero-padding missing
    components: "7.0.14" -> (7, 0, 14); "linux_7_0" -> (7, 0, 0). Tuples compare
    left-to-right, so (7, 0, 14) >= (7, 0, 0) makes the pin's series a floor."""
    nums = [int(n) for n in re.findall(r"\d+", s)][:3]
    nums += [0] * (3 - len(nums))
    return nums[0], nums[1], nums[2]


@dataclass(frozen=True)
class Pkg:
    """A resolved package: its nixpkgs attr name and version."""
    attr: str
    version: Version

    @classmethod
    def from_json(cls, d: dict) -> "Pkg":
        return cls(attr=d["attr"], version=version(d["version"]))

    def to_json(self) -> dict:
        return {"attr": self.attr, "version": ".".join(map(str, self.version))}

    def __str__(self) -> str:
        return f"{self.attr} ({'.'.join(map(str, self.version))})"


@dataclass(frozen=True)
class Compat:
    """A versioned kernel paired with a versioned zfs whose module builds against
    it -- one row of the zfs x linux compatibility matrix, and also the shape of a
    pin in lib/pins.json. Mirrors the JSON emitted by lib/zfs-kernel-matrix.nix."""
    kernel: Pkg
    zfs: Pkg

    @classmethod
    def from_json(cls, d: dict) -> "Compat":
        return cls(kernel=Pkg.from_json(d["kernel"]), zfs=Pkg.from_json(d["zfs"]))

    @classmethod
    def read(cls, path: Path) -> "Compat":
        return cls.from_json(json.loads(path.read_text()))

    def write(self, path: Path) -> None:
        body = {"kernel": self.kernel.to_json(), "zfs": self.zfs.to_json()}
        path.write_text(json.dumps(body, indent=2) + "\n")


def nix(*args: str) -> str:
    """Run a nix subcommand, capturing stdout; stderr is left inherited so nix's
    warnings (e.g. dirty git tree) still surface."""
    return subprocess.run(
        ["nix", *args], check=True, stdout=subprocess.PIPE, text=True
    ).stdout.strip()


def matrix() -> list[Compat]:
    """Evaluate the zfs x linux compatibility projection from the flake output.

    Pure eval (no --impure): the flake exposes `lib.zfsKernelMatrix.<system>`, so
    we address it as an installable rather than getFlake-ing a mutable path.
    x86_64-linux is hardcoded -- every host running this is x86_64 linux (the
    output is defined for all systems regardless)."""
    rows = json.loads(nix("eval", "--json", f"{ROOT}#lib.zfsKernelMatrix.x86_64-linux"))
    return [Compat.from_json(r) for r in rows]


def main() -> int:
    current = Compat.read(PINS)

    print("==> Resolving newest forward-only zfs + compatible kernel from nixpkgs...")

    # Forward-only: only pairs at or above the current pins in both dimensions.
    # The floor is the pinned version itself -- no longer derived from the attr.
    rows = [
        c for c in matrix()
        if c.kernel.version >= current.kernel.version
        and c.zfs.version >= current.zfs.version
    ]
    if rows:
        # Newest kernel, then newest zfs compatible with it.
        chosen = max(rows, key=lambda c: (c.kernel.version, c.zfs.version))
    else:
        # Nothing at/above the floor is compatible: keep pins (never downgrade).
        chosen = current

    chosen.write(PINS)

    if chosen == current:
        print(f"==> Already current ({chosen.kernel} / {chosen.zfs}); no change.")
    else:
        if current.kernel != chosen.kernel:
            print(f"==> kernel: {current.kernel} -> {chosen.kernel}")
        if current.zfs != chosen.zfs:
            print(f"==> zfs:    {current.zfs} -> {chosen.zfs}")
        print(f"==> Wrote {PINS} (review with: git diff -- lib/pins.json)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
