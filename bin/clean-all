#!/usr/bin/env bash

# Remove old generations, GC the Nix store, and prune boot entries on multiple
# NixOS hosts. Usage: ./cleanup-hosts.sh host1 host2 ...

set -euo pipefail

echo "==> Cleaning hosts"
for name in "$@"; do
    echo "-- $name"
    ssh -tt "$name" 'sudo nix-collect-garbage --delete-old'
    ssh -tt "$name" 'nix-collect-garbage --delete-old'
    ssh -tt "$name" 'sudo /run/current-system/bin/switch-to-configuration boot'
done
