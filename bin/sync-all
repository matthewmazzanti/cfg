#!/usr/bin/env bash

set -euo pipefail

echo "==> Fetching repos"
for name in "$@"; do
    echo "-- Fetching $name"
    git fetch "$name"
done
echo

echo "==> Merging repos"
for name in "$@"; do
    echo "-- Merging $name"
    git merge "$name/dev"
done
echo

echo "==> Syncing repos"
for name in "$@"; do
    echo "-- Syncing $name"
    git push "$name"
done
echo
