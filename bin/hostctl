#!/usr/bin/env bash
# hostctl -- build, deploy, and maintain the hosts in this config.
#
# One target axis (this machine, or a remote over ssh) crossed with a few
# lifecycle verbs. The target is an optional argument that defaults to the local
# host, so `hostctl clean` and `hostctl clean desktop.lan` are the same code path
# with an ssh hop auto-inserted for the remote.
#
#   hostctl upgrade [target]   rebuild + activate in place; a remote target
#                              pushes the repo and builds on the host
#   hostctl deploy  <host>     build locally, copy the closure over, then
#                              activate from the host's checkout (remote-only;
#                              the remote reuses the copied paths, no recompile)
#   hostctl clean   [target]   collect old generations + prune boot entries
#   hostctl sync    <host>     git fetch/merge/push the host's checkout
#
# Options:
#   --attr NAME    flake attr / config name (default: target's hostname, or the
#                  host with its domain stripped -- desktop.lan -> desktop)
#   --user NAME    home-manager user for the <user>@<attr> config (default: $USER)
#   --no-hm        skip home-manager (system only)
#   --hm-only      skip the system rebuild (home-manager only)
#   -n, --dry-run  print each step instead of running it
#   -h, --help     this help
#
# The local flake is the git checkout you invoke from (falling back to
# ~/src/nix/cfg); the remote always rebuilds from its own ~/src/nix/cfg.
set -euo pipefail

FLAKE_DIR="$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$HOME/src/nix/cfg")"
# Deliberately unexpanded here: the ~ is sent verbatim and expanded by the
# remote shell, so it points at the remote user's home, not ours.
# shellcheck disable=SC2088
REMOTE_FLAKE='~/src/nix/cfg'
USER_NAME="${USER:-$(id -un)}"
ATTR=
NO_HM=false
HM_ONLY=false
DRY_RUN=false

die()  { printf 'hostctl: %s\n' "$*" >&2; exit 1; }
log()  { printf '\033[1;34m::\033[0m %s\n' "$*" >&2; }
usage() { sed -n '2,/^set -euo/{/^set -euo/!s/^# \{0,1\}//p}' "$0"; }

short_host() { hostname -s 2>/dev/null || hostname; }

# A target names the local host when it is empty, "local[host]", or our hostname.
is_local() {
  case "${1:-}" in
    ''|local|localhost) return 0 ;;
  esac
  [ "$1" = "$(short_host)" ] || [ "$1" = "$(hostname)" ]
}

# Linux gate for the boot-entry prune (Darwin has no switch-to-configuration).
target_is_linux() {
  if is_local "$1"; then [ "$(uname)" = Linux ]; else return 0; fi
}

# The flake attr / config name for a target.
resolve_attr() {
  if [ -n "$ATTR" ]; then printf '%s' "$ATTR"
  elif is_local "$1"; then short_host
  else printf '%s' "${1%.*}"; fi
}

# True iff the flake defines output attr `$1.$2` (checks names only, cheap).
flake_has() {
  nix eval "$FLAKE_DIR#$1" --apply "builtins.hasAttr \"$2\"" 2>/dev/null | grep -qx true
}

# Run a local command (array form), honoring --dry-run.
run() {
  if $DRY_RUN; then printf '  + %s\n' "$*" >&2; return 0; fi
  "$@"
}

# Run a shell command string here or on a remote host (the auto-remoting hop).
sh_on() {
  local target="$1" cmd="$2"
  if is_local "$target"; then
    log "local: $cmd"
    $DRY_RUN || bash -c "$cmd"
  else
    log "$target: $cmd"
    $DRY_RUN || ssh -t "$target" "$cmd"
  fi
}

cmd_clean() {
  local t="$1"
  sh_on "$t" 'nix-collect-garbage --delete-old'
  sh_on "$t" 'sudo nix-collect-garbage --delete-old'
  if target_is_linux "$t"; then
    sh_on "$t" 'sudo /run/current-system/bin/switch-to-configuration boot'
  fi
}

cmd_sync() {
  local t="$1"
  [ -n "$t" ] || die "sync requires a host"
  if is_local "$t"; then die "sync is remote-only"; fi
  run git -C "$FLAKE_DIR" fetch "$t"
  run git -C "$FLAKE_DIR" merge "$t/dev"
  run git -C "$FLAKE_DIR" push "$t"
}

cmd_upgrade() {
  local t="$1" attr; attr="$(resolve_attr "$t")"
  local do_system=true do_hm=true
  if $NO_HM; then do_hm=false; fi
  if $HM_ONLY; then do_system=false; fi
  # Only touch home-manager for hosts that actually define a standalone config.
  if $do_hm && ! flake_has homeConfigurations "$USER_NAME@$attr"; then do_hm=false; fi

  if is_local "$t"; then
    if $do_system; then
      local rebuild=nixos-rebuild
      if [ "$(uname)" = Darwin ]; then rebuild=darwin-rebuild; fi
      sh_on "" "sudo $rebuild switch --flake $FLAKE_DIR -L"
    fi
    if $do_hm; then sh_on "" "home-manager switch --flake $FLAKE_DIR -L"; fi
  else
    run git -C "$FLAKE_DIR" push "$t"
    if $do_system; then sh_on "$t" "sudo nixos-rebuild switch --flake $REMOTE_FLAKE -L"; fi
    if $do_hm; then sh_on "$t" "home-manager switch --flake $REMOTE_FLAKE -L"; fi
  fi
}

cmd_deploy() {
  local t="$1"
  [ -n "$t" ] || die "deploy requires a host"
  if is_local "$t"; then die "deploy is remote-only; use 'upgrade' for this machine"; fi

  local attr; attr="$(resolve_attr "$t")"
  flake_has nixosConfigurations "$attr" || die "no nixosConfigurations.$attr in $FLAKE_DIR"

  local hmkey="$USER_NAME@$attr" do_hm=false
  if ! $NO_HM && flake_has homeConfigurations "$hmkey"; then do_hm=true; fi

  # Collect the store paths to ship. nix build prints one per line; readarray
  # keeps them as separate, quoted elements. Append the HM activationPackage at
  # an offset, guarding that the append added paths so an HM failure aborts.
  local paths=()
  if $DRY_RUN; then
    paths=("<toplevel+closure for $attr>")
    if $do_hm; then paths+=("<home-manager for $hmkey>"); fi
  else
    log "building $attr locally"
    readarray -t paths < <(nix build --no-link --print-out-paths \
      "$FLAKE_DIR#nixosConfigurations.$attr.config.system.build.toplevel")
    [ "${#paths[@]}" -gt 0 ] || die "system build produced no paths"
    if $do_hm; then
      local before=${#paths[@]}
      readarray -t -O "$before" paths < <(nix build --no-link --print-out-paths \
        "$FLAKE_DIR#homeConfigurations.\"$hmkey\".activationPackage")
      [ "${#paths[@]}" -gt "$before" ] || die "home-manager build failed"
    fi
  fi

  log "copying closure to $t"
  run nix copy --to "ssh://$t" "${paths[@]}"
  run git -C "$FLAKE_DIR" push "$t"
  sh_on "$t" "sudo nixos-rebuild switch --flake $REMOTE_FLAKE -L"
  if $do_hm; then sh_on "$t" "home-manager switch --flake $REMOTE_FLAKE -L"; fi
}

main() {
  local cmd='' target='' have_target=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --attr)    ATTR="$2"; shift 2 ;;
      --attr=*)  ATTR="${1#*=}"; shift ;;
      --user)    USER_NAME="$2"; shift 2 ;;
      --user=*)  USER_NAME="${1#*=}"; shift ;;
      --no-hm)   NO_HM=true; shift ;;
      --hm-only) HM_ONLY=true; shift ;;
      -n|--dry-run) DRY_RUN=true; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "unknown option: $1 (see --help)" ;;
      *)
        if [ -z "$cmd" ]; then cmd="$1"
        elif ! $have_target; then target="$1"; have_target=true
        else die "unexpected argument: $1"; fi
        shift ;;
    esac
  done

  if $NO_HM && $HM_ONLY; then die "--no-hm and --hm-only are mutually exclusive"; fi

  case "$cmd" in
    upgrade) cmd_upgrade "$target" ;;
    deploy)  cmd_deploy  "$target" ;;
    clean)   cmd_clean   "$target" ;;
    sync)    cmd_sync    "$target" ;;
    ''|help) usage ;;
    *) die "unknown command: $cmd (see --help)" ;;
  esac
}

main "$@"
