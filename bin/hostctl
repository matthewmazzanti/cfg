#!/usr/bin/env python3
"""hostctl -- build, deploy, and maintain the hosts in this config.

One target axis (this machine, or a remote over ssh) crossed with a few
lifecycle verbs. A target is a flake config name (e.g. `desktop`) and defaults
to this machine, so `hostctl clean` and `hostctl clean desktop` are the same
code path with an ssh hop auto-inserted for the remote. SSH_HOSTS maps each attr
to the ssh host it's reached at (used for ssh, nix copy, and git URLs).

    hostctl upgrade [host...]  rebuild + activate hosts. For a remote this
                               defaults to "deploy mode" -- build the closure
                               locally, copy it over, then activate from the
                               host's checkout (no remote recompile). Deploy
                               mode needs the target's system to match this
                               machine's; otherwise (or with --build-on-host)
                               the host builds from its own checkout.
                               (alias: `deploy`)
    hostctl clean   [host...]  collect old generations + prune boot entries
    hostctl sync    <host...>  git fetch/merge/push each host's checkout (layered)

NixOS and nix-darwin hosts are handled uniformly: each target's kind and system
are read from the flake, so the rebuild command and boot-entry prune follow the
host, not an assumption about local-vs-remote.

The local flake is the git checkout you invoke from (falling back to
~/src/nix/cfg); the remote always rebuilds from its own ~/src/nix/cfg.

Stdlib only, matching bin/bump-kernel and bin/lock-images.
"""

import argparse
import getpass
import json
import os
import platform
import shlex
import socket
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import NoReturn, Self

REMOTE_FLAKE = "~/src/nix/cfg"  # literal; expanded by the remote shell

# Flake attr -> the host's ssh/DNS name. Used for ssh, nix copy, and the git URL
# (git_url), so no named git remotes are needed. Attrs absent fall back to the attr.
SSH_HOSTS = {
    "beta": "beta.lan",
    "delta": "delta.lan",
    "desktop": "desktop.lan",
    "framework": "framework.lan",
    "ha": "ha.iot",
    "print": "print.lan",
    "server": "server.lan",
}


def flake_dir() -> Path:
    """The checkout we operate on: the enclosing git repo, else ~/src/nix/cfg."""
    try:
        top = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            text=True, capture_output=True, check=True,
        ).stdout.strip()
        return Path(top)
    except (subprocess.CalledProcessError, FileNotFoundError):
        return Path.home() / "src/nix/cfg"


FLAKE = flake_dir()


def local_system() -> str:
    """This machine's nix system string, e.g. x86_64-linux -- the builder we
    can produce closures for without remote builders or emulation."""
    arch = {"amd64": "x86_64", "arm64": "aarch64"}
    machine = platform.machine().lower()
    kernel = "darwin" if platform.system() == "Darwin" else "linux"
    return f"{arch.get(machine, machine)}-{kernel}"


LOCAL_SYSTEM = local_system()


def die(msg: str) -> NoReturn:
    print(f"hostctl: {msg}", file=sys.stderr)
    sys.exit(1)


def log(msg: str) -> None:
    print(f"\033[1;34m::\033[0m {msg}", file=sys.stderr)


@dataclass
class Host:
    """A deploy target named by its flake `attr`; `name` is the ssh host it maps
    to (also the git URL host). `local` runs here vs over ssh; kind and system
    are read from the flake by Host.resolve()."""

    name: str  # ssh host / git URL host / network address (hostname when local)
    attr: str  # flake config name -- what you type
    user: str  # home-manager user, for the <user>@<attr> config
    local: bool  # run commands here rather than over ssh
    kind: str = ""  # "nixos" | "darwin"
    system: str = ""  # e.g. "x86_64-linux"

    @classmethod
    def resolve(cls, target: str, user: str | None = None) -> Self:
        """Resolve a target (a flake config name, empty for this machine) into a
        Host, mapping it to a network handle and reading its kind + system."""
        user = user or os.environ.get("USER") or getpass.getuser()
        short = socket.gethostname().split(".")[0]
        local = is_local(target)
        attr = short if local else target
        host = cls(
            name=short if local else SSH_HOSTS.get(attr, attr),
            attr=attr,
            user=user,
            local=local,
        )
        for kind, output in (("nixos", "nixosConfigurations"), ("darwin", "darwinConfigurations")):
            try:
                host.system = nix_eval_raw(f"{FLAKE}#{output}.{host.attr}.pkgs.system")
            except subprocess.CalledProcessError:
                continue
            host.kind = kind
            return host
        die(f"no nixos/darwin configuration '{host.attr}' in {FLAKE}")

    @property
    def darwin(self) -> bool:
        return self.kind == "darwin"

    @property
    def is_linux(self) -> bool:
        return self.system.endswith("linux")

    @property
    def hm_key(self) -> str:
        return f"{self.user}@{self.attr}"

    @property
    def config_output(self) -> str:
        return "darwinConfigurations" if self.darwin else "nixosConfigurations"

    def toplevel(self, flake: str | Path) -> str:
        """The system-closure installable under a flake ref (config.system.build.
        toplevel resolves for both NixOS and nix-darwin)."""
        return f"{flake}#{self.config_output}.{self.attr}.config.system.build.toplevel"

    def hm_pkg(self, flake: str | Path) -> str:
        """The home-manager activationPackage installable under a flake ref."""
        return f'{flake}#homeConfigurations."{self.hm_key}".activationPackage'

    @property
    def flake(self) -> str:
        """The flake to activate from: our checkout locally, the host's own
        ~/src/nix/cfg over ssh."""
        return str(FLAKE) if self.local else REMOTE_FLAKE

    def run(self, *argv: str) -> None:
        """Run a shell command on this host: bash -c locally, else over ssh. Args
        are joined into one command line, so quote any that contain spaces."""
        line = " ".join(argv)
        log(f"{self.name}: {line}")
        cmd = ["bash", "-c", line] if self.local else ["ssh", "-t", self.name, line]
        subprocess.run(cmd, check=True)

    def capture(self, *argv: str) -> str:
        """Like run() but return stdout (stderr still streams); no tty. For
        non-interactive commands whose output we need, e.g. a built store path."""
        line = " ".join(argv)
        log(f"{self.name}: {line}")
        cmd = ["bash", "-c", line] if self.local else ["ssh", self.name, line]
        return subprocess.run(cmd, text=True, stdout=subprocess.PIPE, check=True).stdout.strip()


def is_local(target: str) -> bool:
    """Whether a target names this machine rather than a remote."""
    short = socket.gethostname().split(".")[0]
    return target in ("local", "localhost", short, socket.gethostname())


def flake_has(output: str, name: str) -> bool:
    """True iff the flake defines output attr `output.name` (names only, cheap)."""
    res = subprocess.run(
        [
            "nix",
            "eval",
            f"{FLAKE}#{output}",
            "--apply",
            f'builtins.hasAttr "{name}"',
        ],
        text=True, capture_output=True,
    )
    return res.returncode == 0 and res.stdout.strip() == "true"


def nix_eval_raw(installable: str) -> str:
    """Evaluate an installable to a raw string (raises if the attr is absent)."""
    return subprocess.run(
        ["nix", "eval", "--raw", installable],
        text=True, capture_output=True, check=True,
    ).stdout.strip()


def nix_build_json(installables: list[str]) -> list[dict]:
    """Build installables in one pass; return nix's per-installable JSON result,
    aligned with the input order. stdout carries the JSON; stderr (progress) streams."""
    out = subprocess.run(
        ["nix", "build", "-L", "--no-link", "--json", *installables],
        text=True, stdout=subprocess.PIPE, check=True,
    ).stdout
    return json.loads(out)


def working_tree_dirty() -> bool:
    """True if tracked files differ from HEAD -- i.e. uncommitted changes that a
    remote (which builds from your pushed commits) wouldn't see. Untracked files
    are ignored; the flake eval doesn't see them either."""
    return subprocess.run(
        ["git", "-C", FLAKE, "diff", "--quiet", "HEAD"],
        capture_output=True,
    ).returncode != 0


def builds_locally(host: Host, build_on_host: bool) -> bool:
    """Whether this host's closure is built on the machine we run from: the local
    host, or a same-system remote not forced onto itself with --build-on-host."""
    return host.local or (not build_on_host and host.system == LOCAL_SYSTEM)


def build_local(here: list[tuple[Host, set[str]]]) -> dict[str, dict[str, str]]:
    """Build every locally-buildable host's closure in one nix pass, copy each
    remote's outputs over, and return each host's built paths keyed by part."""
    jobs = []  # (attr, part, installable)
    for host, parts in here:
        if "sys" in parts:
            jobs.append((host.attr, "sys", host.toplevel(FLAKE)))
        if "hm" in parts:
            jobs.append((host.attr, "hm", host.hm_pkg(FLAKE)))
    if not jobs:
        return {}

    log(f"building {len(here)} host(s) locally")
    built = nix_build_json([inst for _, _, inst in jobs])
    if len(built) != len(jobs):  # positional mapping below needs 1:1 (distinct installables)
        die(f"nix build returned {len(built)} results for {len(jobs)} installables")
    paths: dict[str, dict[str, str]] = {}  # attr -> {part: out path}
    for (attr, part, _), entry in zip(jobs, built):
        paths.setdefault(attr, {})[part] = entry["outputs"]["out"]

    for host, _ in here:
        if not host.local:  # local host activates straight from the store
            log(f"copying closure to {host.name}")
            subprocess.run(["nix", "copy", "--to", f"ssh://{host.name}", *paths[host.attr].values()], check=True)
    return paths


def build_remote(host: Host, parts: set[str], *, build_on_host: bool) -> dict[str, str]:
    """Have the host build its own closure (--build-on-host or a cross-system
    target); return the built paths (in the host's store) keyed by part."""
    if not build_on_host and host.system != LOCAL_SYSTEM:
        log(f"can't build {host.system} on this {LOCAL_SYSTEM} host; building on {host.name}")
    paths = {}  # part -> out path
    if "sys" in parts:
        paths["sys"] = host.capture("nix", "build", "-L", "--print-out-paths", "--no-link", host.toplevel(host.flake))
    if "hm" in parts:
        paths["hm"] = host.capture("nix", "build", "-L", "--print-out-paths", "--no-link", host.hm_pkg(host.flake))
    return paths


def switch_host(host: Host, parts: set[str], paths: dict[str, str]) -> None:
    """Activate the pre-built store paths directly -- no re-eval, no rebuild.
    nixos-rebuild --store-path / darwin-rebuild activate / hm's activate all
    take an already-built path and run the proper guarded activation."""
    if "sys" in parts:
        if host.darwin:
            host.run("sudo", f"{paths['sys']}/sw/bin/darwin-rebuild", "activate")
        else:
            host.run("sudo", "nixos-rebuild", "switch", "--store-path", paths["sys"])
    if "hm" in parts:
        host.run(f"{paths['hm']}/activate")


def git_url(attr: str) -> str:
    """The host's repo reachable over ssh (e.g. desktop.lan:src/nix/cfg), built
    from SSH_HOSTS -- so no named git remote has to be registered."""
    return f"{SSH_HOSTS.get(attr, attr)}:{REMOTE_FLAKE.removeprefix('~/')}"


def cmd_upgrade(args: argparse.Namespace) -> None:
    targets = args.targets or ["local"]
    # one shared working tree, so the dirty guard is a single up-front check.
    if any(not is_local(t) for t in targets) and working_tree_dirty():
        die(f"refusing to deploy: uncommitted changes in {FLAKE} "
            "-- the remote builds from your pushed commits; commit or stash first")

    # plan every host before touching any, so a bad target fails the batch early.
    # parts = what was asked for, minus home-manager on hosts with no standalone
    # config (empty, i.e. skipped, only for --only hm against such a host).
    # dedup by attr (targets can alias, e.g. localhost == hostname) so build_local's
    # installables stay distinct -- its output mapping relies on that.
    plan = []
    seen: set[str] = set()
    for target in targets:
        host = Host.resolve(target, args.user)
        if host.attr in seen:
            continue
        seen.add(host.attr)
        parts = {args.only} if args.only else {"sys", "hm"}
        if "hm" in parts and not flake_has("homeConfigurations", host.hm_key):
            parts.discard("hm")
        if not parts:
            log(f"{host.attr}: no home-manager config, skipping")
            continue
        plan.append((host, parts))

    # staged like sync: push all, build all, switch all -- so a build failure
    # stops the batch before any host is switched. Everything buildable here goes
    # in one nix pass; the rest fan out to build on their own hosts.
    for host, _ in plan:
        if not host.local:
            subprocess.run(["git", "-C", FLAKE, "push", git_url(host.attr), "HEAD"], check=True)

    here, there = [], []
    for host, parts in plan:
        bucket = here if builds_locally(host, args.build_on_host) else there
        bucket.append((host, parts))
    built = build_local(here)  # attr -> {part: store path}
    for host, parts in there:
        built[host.attr] = build_remote(host, parts, build_on_host=args.build_on_host)

    for host, parts in plan:
        switch_host(host, parts, built[host.attr])


def clean_host(host: Host) -> None:
    """GC old generations on a host, then prune stale boot entries (Linux only).
    The root steps share one sudo, so the host prompts for a password once."""
    host.run("nix-collect-garbage", "--delete-old")  # user profile
    root = "nix-collect-garbage --delete-old"  # system profile
    if host.is_linux:  # Darwin has no switch-to-configuration
        root += " && /run/current-system/bin/switch-to-configuration boot"
    host.run("sudo", "sh", "-c", shlex.quote(root))


def cmd_clean(args: argparse.Namespace) -> None:
    # sequential: each host's `sudo nix-collect-garbage` prompts on its own tty.
    for target in args.targets or ["local"]:
        clean_host(Host.resolve(target))


def cmd_sync(args: argparse.Namespace) -> None:
    # Layered across hosts so a failure stops before the next phase mutates a host:
    # fetch every host's dev (each into its own ref -- FETCH_HEAD holds only one),
    # merge them all into the current branch, then push the result back to each.
    git = ["git", "-C", FLAKE]
    hosts = [(attr, git_url(attr)) for attr in args.targets]
    for attr, url in hosts:
        log(f"{attr}: fetch dev")
        subprocess.run([*git, "fetch", url, f"+dev:refs/hostctl/{attr}"], check=True)
    for attr, _ in hosts:
        log(f"{attr}: merge")
        subprocess.run([*git, "merge", f"refs/hostctl/{attr}"], check=True)
    for attr, url in hosts:
        log(f"{attr}: push HEAD")
        subprocess.run([*git, "push", url, "HEAD"], check=True)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="hostctl",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="command", required=True)

    up = sub.add_parser(
        "upgrade",
        aliases=["deploy"],
        help="rebuild + activate a host (deploy mode by default)"
    )
    up.add_argument("targets", nargs="*", help="hosts (default: this machine)")
    up.add_argument(
        "--user",
        default=os.environ.get("USER") or getpass.getuser(),
        help="home-manager user (default: $USER)"
    )
    up.add_argument(
        "--build-on-host",
        action="store_true",
        help="let the remote build from its checkout instead of " "shipping a prebuilt closure (no-op for the local host)"
    )
    up.add_argument(
        "--only",
        choices=("sys", "hm"),
        help="activate only this part (default: system + home-manager)"
    )
    up.set_defaults(func=cmd_upgrade)

    cl = sub.add_parser("clean", help="gc old generations + prune boot entries")
    cl.add_argument("targets", nargs="*", help="hosts (default: this machine)")
    cl.set_defaults(func=cmd_clean)

    sy = sub.add_parser("sync", help="git fetch/merge/push hosts' checkouts")
    sy.add_argument("targets", nargs="+", help="hosts to sync (flake attrs)")
    sy.set_defaults(func=cmd_sync)

    return p


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    try:
        args.func(args)
    except subprocess.CalledProcessError as e:
        return e.returncode or 1
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
